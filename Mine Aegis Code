    // GIS Map Canvas
    let canvas, ctx, angleRadar = 0;
    function initMapCanvas() {
      canvas = document.getElementById('meshCanvas');
      ctx = canvas.getContext('2d');
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      canvas.addEventListener('click', handleCanvasClick);
      requestAnimationFrame(drawMapFrame);
    }

    function resizeCanvas() {
      const container = document.getElementById('mapContainer');
      if (!container || !canvas) return;
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
    }

    function drawMapFrame() {
      if (!canvas || !ctx) return;
      const w = canvas.width, h = canvas.height;
      ctx.fillStyle = '#090d16';
      ctx.fillRect(0, 0, w, h);

      // Grid
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      for (let x = 0; x < w; x += 40) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke(); }
      for (let y = 0; y < h; y += 40) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(w, y); ctx.stroke(); }

      // Radar Rings
      const centerX = w * 0.5, centerY = h * 0.55;
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';
      [80, 160, 240, 320].forEach(r => { ctx.beginPath(); ctx.arc(centerX, centerY, r, 0, Math.PI * 2); ctx.stroke(); });

      // Radar Sweep
      angleRadar += 0.015;
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(angleRadar);
      const gradRadar = ctx.createRadialGradient(0, 0, 10, 0, 0, 240);
      gradRadar.addColorStop(0, 'rgba(56, 189, 248, 0.25)');
      gradRadar.addColorStop(1, 'rgba(56, 189, 248, 0)');
      ctx.fillStyle = gradRadar;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.arc(0, 0, 240, 0, Math.PI * 0.25);
      ctx.closePath();
      ctx.fill();
      ctx.restore();

      // Zones
      ctx.strokeStyle = (currentRiskLevel === 'CRITICAL' || currentRiskLevel === 'HIGH') ? 'rgba(239, 68, 68, 0.8)' : 'rgba(245, 158, 11, 0.6)';
      ctx.setLineDash([5, 5]);
      ctx.strokeRect(w * 0.22, h * 0.18, w * 0.22, h * 0.35);
      ctx.fillStyle = 'rgba(239, 68, 68, 0.08)';
      ctx.fillRect(w * 0.22, h * 0.18, w * 0.22, h * 0.35);
      ctx.fillStyle = '#ef4444';
      ctx.font = 'bold 10px monospace';
      ctx.fillText('[Zone A] ACTIVE DEPILLARING FACE', w * 0.23, h * 0.22);
      ctx.fillStyle = '#f8fafc';
      ctx.fillText('SERIES MINE FACE 1 COAL', w * 0.23, h * 0.48);

      ctx.strokeStyle = 'rgba(56, 189, 248, 0.7)';
      ctx.setLineDash([]);
      ctx.strokeRect(w * 0.46, h * 0.18, w * 0.25, h * 0.42);
      ctx.fillStyle = '#38bdf8';
      ctx.fillText('[Zone B] CENTRAL STABILITY', w * 0.48, h * 0.22);

      ctx.strokeStyle = 'rgba(100, 116, 139, 0.5)';
      ctx.strokeRect(w * 0.22, h * 0.65, w * 0.24, h * 0.28);
      ctx.fillStyle = '#94a3b8';
      ctx.fillText('[Zone C] SW PANEL', w * 0.23, h * 0.69);

      ctx.strokeRect(w * 0.52, h * 0.65, w * 0.24, h * 0.28);
      ctx.fillText('[Zone D] SE PANEL', w * 0.54, h * 0.69);

      // Heatmap
      if (heatmapEnabled || currentRiskLevel === 'HIGH' || currentRiskLevel === 'CRITICAL') {
        const heatX = w * 0.33, heatY = h * 0.37, heatRadius = (currentRiskLevel === 'CRITICAL') ? 140 : 80;
        const gradHeat = ctx.createRadialGradient(heatX, heatY, 5, heatX, heatY, heatRadius);
        if (currentRiskLevel === 'CRITICAL') {
          gradHeat.addColorStop(0, 'rgba(239, 68, 68, 0.75)');
          gradHeat.addColorStop(0.5, 'rgba(249, 115, 22, 0.5)');
          gradHeat.addColorStop(1, 'rgba(239, 68, 68, 0)');
        } else {
          gradHeat.addColorStop(0, 'rgba(245, 158, 11, 0.6)');
          gradHeat.addColorStop(1, 'rgba(245, 158, 11, 0)');
        }
        ctx.fillStyle = gradHeat;
        ctx.beginPath();
        ctx.arc(heatX, heatY, heatRadius, 0, Math.PI * 2);
        ctx.fill();
      }

      // Mesh Links & Packets
      if (meshLinesEnabled) {
        meshLinks.forEach((link, linkIdx) => {
          const nodeA = nodes.find(n => n.id === link[0]);
          const nodeB = nodes.find(n => n.id === link[1]);
          if (!nodeA || !nodeB) return;
          if (activeNodeFailure && (nodeA.id === failedNodeId || nodeB.id === failedNodeId)) return;

          const ax = nodeA.xRel * w, ay = nodeA.yRel * h;
          const bx = nodeB.xRel * w, by = nodeB.yRel * h;

          ctx.beginPath();
          ctx.moveTo(ax, ay);
          ctx.lineTo(bx, by);
          ctx.setLineDash([4, 4]);
          ctx.strokeStyle = (currentRiskLevel === 'CRITICAL') ? 'rgba(239, 68, 68, 0.6)' : 'rgba(56, 189, 248, 0.45)';
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.setLineDash([]);

          const pkt = signalPackets[linkIdx];
          if (pkt) {
            pkt.progress += pkt.speed;
            if (pkt.progress > 1) pkt.progress = 0;
            const px = ax + (bx - ax) * pkt.progress;
            const py = ay + (by - ay) * pkt.progress;
            ctx.fillStyle = (currentRiskLevel === 'CRITICAL') ? '#ef4444' : '#38bdf8';
            ctx.beginPath();
            ctx.arc(px, py, 3.5, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }

      // Draw Nodes
      nodes.forEach(n => {
        const nx = n.xRel * w, ny = n.yRel * h;
        if (activeNodeFailure && n.id === failedNodeId) {
          ctx.fillStyle = '#64748b';
          ctx.beginPath();
          ctx.arc(nx, ny, 7, 0, Math.PI * 2);
          ctx.fill();
          ctx.strokeStyle = '#ef4444';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.fillStyle = '#ef4444';
          ctx.font = 'bold 9px monospace';
          ctx.fillText(n.id + ' [OFFLINE]', nx + 10, ny + 3);
          return;
        }

        if (n.status === 'WATCH' || n.status === 'HIGH' || n.status === 'CRITICAL') {
          const pulseRadius = 12 + Math.sin(Date.now() * 0.008) * 4;
          ctx.fillStyle = (n.status === 'CRITICAL') ? 'rgba(239, 68, 68, 0.35)' : 'rgba(245, 158, 11, 0.35)';
          ctx.beginPath();
          ctx.arc(nx, ny, pulseRadius, 0, Math.PI * 2);
          ctx.fill();
        }

        let nodeColor = '#10b981';
        if (n.isGateway) nodeColor = '#2563eb';
        else if (n.status === 'WATCH') nodeColor = '#f59e0b';
        else if (n.status === 'HIGH') nodeColor = '#f97316';
        else if (n.status === 'CRITICAL') nodeColor = '#ef4444';

        ctx.fillStyle = nodeColor;
        ctx.beginPath();
        ctx.arc(nx, ny, n.isGateway ? 10 : 7, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.font = 'bold 10px monospace';
        ctx.fillText(n.id, nx + 10, ny + 3);

        if (!n.isGateway) {
          ctx.fillStyle = '#94a3b8';
          ctx.font = '9px monospace';
          ctx.fillText(`${n.tilt}° | ${n.disp}mm`, nx + 10, ny + 14);
        }
      });

      requestAnimationFrame(drawMapFrame);
    }

    function handleCanvasClick(e) {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left, clickY = e.clientY - rect.top;
      const w = canvas.width, h = canvas.height;
      nodes.forEach(n => {
        const nx = n.xRel * w, ny = n.yRel * h;
        if (Math.sqrt((clickX - nx) ** 2 + (clickY - ny) ** 2) <= 16) openNodeModal(n);
      });
    }


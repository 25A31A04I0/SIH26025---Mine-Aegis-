    // Nodes Definition
    const nodes = [
      { id: 'SN-01-A', name: 'Node 01 (Depillaring)', zone: 'Zone A', xRel: 0.28, yRel: 0.32, tilt: 0.24, disp: 0.5, vib: 0.02, crack: 0.0, battery: 98, rssi: -72, status: 'NORMAL' },

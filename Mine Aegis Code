    // Sound Siren (Web Audio API)
    let sirenAudioCtx = null, sirenOsc = null, sirenGain = null, sirenTimer = null, isSirenActive = false;

    function triggerSirenAlert() {
      stopSirenAlert();
      const banner = document.getElementById('alarmBanner');
      if (banner) banner.classList.add('active');
      try {
        sirenAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (sirenAudioCtx.state === 'suspended') sirenAudioCtx.resume();
        sirenOsc = sirenAudioCtx.createOscillator();
        sirenGain = sirenAudioCtx.createGain();
        sirenOsc.type = 'sawtooth';
        sirenOsc.frequency.setValueAtTime(650, sirenAudioCtx.currentTime);
        let isHighPitch = false;
        sirenTimer = setInterval(() => {
          if (!sirenOsc || !sirenAudioCtx) return;
          sirenOsc.frequency.linearRampToValueAtTime(isHighPitch ? 650 : 950, sirenAudioCtx.currentTime + 0.35);
          isHighPitch = !isHighPitch;
        }, 380);
        sirenGain.gain.setValueAtTime(0.25, sirenAudioCtx.currentTime);
        sirenOsc.connect(sirenGain);
        sirenGain.connect(sirenAudioCtx.destination);
        sirenOsc.start();
        isSirenActive = true;
        logTerminalMsg('[AUDIO SIREN] Continuous Emergency Alarm Siren RINGING!');
      } catch (err) { console.log('Audio Context Error:', err); }
    }

    function stopSirenAlert() {
      if (sirenTimer) { clearInterval(sirenTimer); sirenTimer = null; }
      if (sirenOsc) { try { sirenOsc.stop(); sirenOsc.disconnect(); } catch (e) {} sirenOsc = null; }
      if (sirenAudioCtx) { try { sirenAudioCtx.close(); } catch (e) {} sirenAudioCtx = null; }
      isSirenActive = false;
      const banner = document.getElementById('alarmBanner');
      if (banner) banner.classList.remove('active');
      logTerminalMsg('[AUDIO SIREN] Alarm Siren Muted / Stopped.');
    }

    document.addEventListener('click', () => {
      if (sirenAudioCtx && sirenAudioCtx.state === 'suspended') sirenAudioCtx.resume();
    });

    function toggleOfflineMode() {
      isOfflineMode = !isOfflineMode;
      const btn = document.getElementById('btnToggleOffline');
      if (isOfflineMode) {
        btn.innerHTML = `<i class="fa-solid fa-wifi-slash" style="color:#ef4444;"></i> Status: OFFLINE (Edge Buffer Active)`;
        logTerminalMsg('[NETWORK STACK] Switched to Offline Mode. Telemetry buffering in local Flash storage.');
      } else {
        btn.innerHTML = `<i class="fa-solid fa-wifi" style="color:#10b981;"></i> Status: ONLINE (Cloud Sync Active)`;
        logTerminalMsg('[NETWORK STACK] Connection restored. Synchronized 142 records to Cloud Database.');
      }
    }

    function exportDataCSV() {
      let csv = 'Node_ID,Zone,Tilt_Deg,Displacement_mm,Vibration_g,Crack_mm,Battery_Pct,RSSI_dBm,Status\n';
      nodes.forEach(n => { csv += `${n.id},${n.zone},${n.tilt},${n.disp},${n.vib},${n.crack},${n.battery},${n.rssi},${n.status}\n`; });
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = window.URL.createObjectURL(blob);
      a.download = 'mine_aegis_surface_mesh_report.csv';
      a.click();
      logTerminalMsg('[EXPORT] Exported telemetry report CSV file.');
    }

    function dispatchTestAlert() {
      alert(`[MINE AEGIS EARLY WARNING DISPATCH]\n\nMulti-channel alert successfully sent!\nSMS: DGMS Safety Manager (+91 9876543210)\nEmail: safetymanager@coalindia.in\nApp Push: Mine Aegis Operator App`);
      logTerminalMsg('[ALERT DISPATCH] Test notification sent via Twilio SMS & SendGrid SMTP.');
    }

    function logTerminalMsg(msg) {
      const term = document.getElementById('logTerminal');
      if (!term) return;
      term.innerHTML = `[${new Date().toLocaleTimeString()}] ${msg}<br>` + term.innerHTML;
    }
  </script>
</body>

      { id: 'GW-01',    name: 'Gateway GW-01', zone: 'Zone B', xRel: 0.50, yRel: 0.55, tilt: 0.00, disp: 0.0, vib: 0.00, crack: 0.0, battery: 100, rssi: -50, status: 'GATEWAY', isGateway: true },
      { id: 'SN-03-B', name: 'Node 03 (Central)', zone: 'Zone B', xRel: 0.50, yRel: 0.30, tilt: 0.15, disp: 0.3, vib: 0.01, crack: 0.0, battery: 94, rssi: -68, status: 'NORMAL' },
      { id: 'SN-04-B', name: 'Node 04 (North-East)', zone: 'Zone B', xRel: 0.62, yRel: 0.40, tilt: 0.18, disp: 0.4, vib: 0.01, crack: 0.0, battery: 97, rssi: -71, status: 'NORMAL' },
      { id: 'SN-05-C', name: 'Node 05 (South-West)', zone: 'Zone C', xRel: 0.33, yRel: 0.78, tilt: 0.12, disp: 0.2, vib: 0.01, crack: 0.0, battery: 92, rssi: -82, status: 'NORMAL' },
      { id: 'SN-06-C', name: 'Node 06 (West Panel)', zone: 'Zone C', xRel: 0.44, yRel: 0.85, tilt: 0.14, disp: 0.3, vib: 0.01, crack: 0.0, battery: 95, rssi: -78, status: 'NORMAL' },
      { id: 'SN-07-D', name: 'Node 07 (East Panel)', zone: 'Zone D', xRel: 0.58, yRel: 0.84, tilt: 0.10, disp: 0.2, vib: 0.01, crack: 0.0, battery: 99, rssi: -76, status: 'NORMAL' },
      { id: 'SN-08-D', name: 'Node 08 (South-East)', zone: 'Zone D', xRel: 0.68, yRel: 0.68, tilt: 0.11, disp: 0.2, vib: 0.01, crack: 0.0, battery: 91, rssi: -80, status: 'NORMAL' }
    ];

    // Mesh Links
    const meshLinks = [
      ['SN-01-A', 'SN-02-A'],
      ['SN-02-A', 'GW-01'],
      ['SN-03-B', 'GW-01'],
      ['SN-04-B', 'GW-01'],
      ['SN-05-C', 'SN-06-C'],
      ['SN-06-C', 'GW-01'],
      ['SN-07-D', 'SN-08-D'],
      ['SN-08-D', 'GW-01'],
      ['SN-02-A', 'SN-04-B'],
      ['SN-06-C', 'SN-07-D']
    ];

    let signalPackets = [];
    for (let i = 0; i < meshLinks.length; i++) {
      signalPackets.push({ linkIndex: i, progress: Math.random(), speed: 0.005 + Math.random() * 0.005 });
    }

    let chartTimeSeries, chartRadarFusion, chartRssi, chartBattery;

    document.addEventListener('DOMContentLoaded', () => {
      initMapCanvas();
      renderNodeListMini();
      initCharts();
      renderSpatiotemporalGrid();
      renderMeshDiagram();
      startTelemetryLoop();
    });

    function switchTab(tabId, btnElement) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      btnElement.classList.add('active');
      if (tabId === 'gisMap') setTimeout(resizeCanvas, 100);
    }

    function setRiskLevel(level) {
      currentRiskLevel = level;
      document.querySelectorAll('.btn-level').forEach(btn => btn.classList.remove('active'));
      document.getElementById('btn' + level.charAt(0).toUpperCase() + level.slice(1).toLowerCase()).classList.add('active');
      
      const slider = document.getElementById('sliderTilt');
      if (level === 'NORMAL') {
        slider.value = 0.3;
        nodes.forEach(n => {
          if (!n.isGateway) {
            n.tilt = (0.1 + Math.random() * 0.3).toFixed(2);
            n.disp = (0.2 + Math.random() * 0.4).toFixed(2);
            n.vib = (0.01 + Math.random() * 0.02).toFixed(2);
            n.crack = 0.0;
            n.status = 'NORMAL';
          }
        });
      } else if (level === 'WATCH') {
        slider.value = 2.4;
        nodes.forEach(n => {
          if (n.zone === 'Zone A' && !n.isGateway) {
            n.tilt = (2.1 + Math.random() * 0.8).toFixed(2);
            n.disp = (3.2 + Math.random() * 1.0).toFixed(2);
            n.vib = (0.12 + Math.random() * 0.05).toFixed(2);
            n.crack = 0.4;
            n.status = 'WATCH';
          } else if (!n.isGateway) {
            n.tilt = (0.4 + Math.random() * 0.3).toFixed(2);
            n.disp = (0.8 + Math.random() * 0.4).toFixed(2);
            n.status = 'NORMAL';
          }
        });
      } else if (level === 'HIGH') {
        slider.value = 6.5;
        nodes.forEach(n => {
          if (n.zone === 'Zone A' && !n.isGateway) {
            n.tilt = (6.2 + Math.random() * 1.5).toFixed(2);
            n.disp = (8.4 + Math.random() * 2.0).toFixed(2);
            n.vib = (0.45 + Math.random() * 0.15).toFixed(2);
            n.crack = 1.8;
            n.status = 'HIGH';
          } else if (n.zone === 'Zone B' && !n.isGateway) {
            n.tilt = (2.2 + Math.random() * 0.5).toFixed(2);
            n.disp = (2.8 + Math.random() * 0.5).toFixed(2);
            n.status = 'WATCH';
          } else if (!n.isGateway) {
            n.tilt = (0.6 + Math.random() * 0.3).toFixed(2);
            n.status = 'NORMAL';
          }
        });
      } else if (level === 'CRITICAL') {
        slider.value = 14.2;
        nodes.forEach(n => {
          if (n.zone === 'Zone A' && !n.isGateway) {
            n.tilt = (13.8 + Math.random() * 2.5).toFixed(2);
            n.disp = (21.5 + Math.random() * 4.0).toFixed(2);
            n.vib = (1.25 + Math.random() * 0.45).toFixed(2);
            n.crack = 6.2;
            n.status = 'CRITICAL';
          } else if (!n.isGateway) {
            n.tilt = (5.5 + Math.random() * 2.0).toFixed(2);
            n.disp = (7.8 + Math.random() * 2.5).toFixed(2);
            n.vib = (0.35 + Math.random() * 0.1).toFixed(2);
            n.crack = 1.5;
            n.status = 'HIGH';
          }
        });
        triggerSirenAlert();
      }

      if (level !== 'CRITICAL') stopSirenAlert();

      document.getElementById('lblTiltSlider').innerText = slider.value + '°';
      updateUIOverall();
      logTerminalMsg(`[RISK LEVEL CHANGED] System state updated to ${level}`);
    }

    function onTiltSliderChange(val) {
      document.getElementById('lblTiltSlider').innerText = val + '°';
      const f = parseFloat(val);
      if (f < 1.0) setRiskLevel('NORMAL');
      else if (f < 4.0) setRiskLevel('WATCH');
      else if (f < 10.0) setRiskLevel('HIGH');
      else setRiskLevel('CRITICAL');
    }

    function updateUIOverall() {
      let maxTilt = 0, maxDisp = 0;
      nodes.forEach(n => {
        if (!n.isGateway) {
          if (parseFloat(n.tilt) > maxTilt) maxTilt = parseFloat(n.tilt);
